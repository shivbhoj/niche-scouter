# --- Database (Postgres) -----------------------------------------------
# Pooled connection string used by the app at runtime. On serverless
# platforms this MUST point at a pooler (Supabase pooler, PgBouncer, Neon
# pooled endpoint) — a connection per invocation will exhaust Postgres
# otherwise.
DATABASE_URL="postgresql://postgres:devpass@127.0.0.1:5432/nichescouter?schema=public"

# Direct (unpooled) connection. Migrations need a real session, which a
# transaction-mode pooler cannot provide. On a single local Postgres this
# is the same value as DATABASE_URL.
DIRECT_URL="postgresql://postgres:devpass@127.0.0.1:5432/nichescouter?schema=public"

# Throwaway database for `npm test`. It is DROPPED AND REBUILT on every
# run, and the harness refuses any name that doesn't contain "test".
TEST_DATABASE_URL="postgresql://postgres:devpass@127.0.0.1:5432/nichescouter_test?schema=public"

# --- Auth ---------------------------------------------------------------
# Any random 32+ char string. `openssl rand -base64 32` works well.
AUTH_SECRET="change-me"

# --- AI research --------------------------------------------------------
# Required for live niche search. https://console.anthropic.com/settings/keys
# Without it, only the bundled example topics work.
ANTHROPIC_API_KEY=""
# Optional. Defaults to claude-opus-5; claude-sonnet-5 roughly halves
# token cost. Measure both with `npm run validate:ai` before choosing.
# ANTHROPIC_MODEL="claude-sonnet-5"

# --- Payments -----------------------------------------------------------
# Test keys: https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=""
# From `stripe listen --print-secret` locally, or the endpoint's signing
# secret in production. Without it the webhook refuses every delivery.
STRIPE_WEBHOOK_SECRET=""

NEXT_PUBLIC_APP_URL="http://localhost:3000"
