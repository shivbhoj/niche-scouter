# SQLite file for local dev. Swap the datasource provider in prisma/schema.prisma
# to "postgresql" and point this at a real Postgres URL for production.
DATABASE_URL="file:./dev.db"

# Any random 32+ char string. `openssl rand -base64 32` works well.
AUTH_SECRET="change-me"

# Required for live niche search (Claude with web search). Get one at
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=""

# Required for real checkout. Get test keys at https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=""
# From `stripe listen --print-secret` (local) or the webhook endpoint's
# signing secret (production).
STRIPE_WEBHOOK_SECRET=""

NEXT_PUBLIC_APP_URL="http://localhost:3000"
