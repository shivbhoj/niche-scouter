generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  // Serverless platforms open a connection per invocation and exhaust a
  // Postgres connection limit fast. Point DATABASE_URL at a pooler
  // (PgBouncer / Supabase pooler / Neon pooled endpoint) and DIRECT_URL
  // at the direct endpoint — migrations need a real session, which a
  // transaction-mode pooler cannot provide.
  directUrl = env("DIRECT_URL")
}

model User {
  id           String       @id @default(cuid())
  email        String       @unique
  passwordHash String
  credits      Int          @default(2)
  createdAt    DateTime     @default(now())
  unlocks      Unlock[]
  creditTxns   CreditTxn[]
}

// One row per distinct topic a user has scouted. Acts as a cache so
// re-searching the same topic doesn't re-spend AI/search calls.
model Market {
  id         String   @id @default(cuid())
  query      String   @unique
  status     String   @default("pending") // pending | ready | error
  errorMsg   String?
  createdAt  DateTime @default(now())
  // Used to detect generations that died mid-flight and are stuck
  // "pending" — see STALE_PENDING_MS.
  updatedAt  DateTime @updatedAt
  niches     Niche[]
}

model Niche {
  id          String   @id @default(cuid())
  marketId    String
  market      Market   @relation(fields: [marketId], references: [id], onDelete: Cascade)
  rank        Int
  name        String
  teaser      String
  demand      Int
  revenue     String
  revenueNote String
  reportJson  String
  unlocks     Unlock[]

  @@unique([marketId, rank])
}

model Unlock {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  nicheId   String
  niche     Niche    @relation(fields: [nicheId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  // Also the concurrency guard: this is what makes a duplicate unlock a
  // constraint violation rather than a double charge.
  @@unique([userId, nicheId])
  // The results page asks "which of these niches does this user own?"
  @@index([nicheId])
}

model CreditTxn {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  delta           Int
  reason          String
  stripeSessionId String?  @unique
  createdAt       DateTime @default(now())

  // The ledger is read per-user (balance audits, history) and only ever
  // grows. Without this the scan is the whole table.
  @@index([userId])
}
